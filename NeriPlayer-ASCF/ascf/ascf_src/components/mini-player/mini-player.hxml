<view class="mini-player" has:if="{{visible}}" bindtap="onOpen">
  <image class="cover" src="{{coverUrl}}" mode="aspectFill" has:if="{{coverUrl}}"></image>
  <view class="cover placeholder" has:else></view>
  <view class="info">
    <text class="title" max-lines="1">{{title}}</text>
    <text class="artist" max-lines="1">{{artist}}</text>
  </view>
  <view class="play-btn" catchtap="onToggle">
    <text class="play-icon">{{loading ? '…' : (playing ? '❚❚' : '▶')}}</text>
  </view>
</view>
