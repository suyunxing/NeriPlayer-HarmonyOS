<view class="page">
  <view class="platform-tabs">
    <view
      class="platform-tab {{platform === 1 ? 'active' : ''}}"
      data-platform="1"
      bindtap="onPlatformChange"
    >
      <text>网易云</text>
    </view>
    <view
      class="platform-tab {{platform === 2 ? 'active' : ''}}"
      data-platform="2"
      bindtap="onPlatformChange"
    >
      <text>哔哩哔哩</text>
    </view>
    <view
      class="platform-tab {{platform === 3 ? 'active' : ''}}"
      data-platform="3"
      bindtap="onPlatformChange"
    >
      <text>YouTube Music</text>
    </view>
  </view>

  <view class="search-box">
    <input
      class="search-input"
      placeholder="输入关键词搜索"
      placeholder-class="placeholder"
      value="{{keyword}}"
      bindinput="onKeywordInput"
      confirm-type="search"
      bindconfirm="onSearchTap"
    />
    <view class="search-btn" bindtap="onSearchTap">
      <text class="search-btn-text">搜索</text>
    </view>
  </view>

  <view class="suggestions" has:if="{{!searched}}">
    <view class="suggest-title"><text>热门搜索</text></view>
    <view class="suggest-list">
      <view
        class="suggest-item"
        has:for="{{suggestions}}"
        has:key="*this"
        data-keyword="{{item}}"
        bindtap="onSuggestionTap"
      >
        <text>{{item}}</text>
      </view>
    </view>
  </view>

  <view class="results" has:if="{{searched}}">
    <view has:if="{{searching}}"><text class="hint">搜索中...</text></view>
    <view has:elif="{{errorMessage}}"><text class="hint error">{{errorMessage}}</text></view>
    <view has:elif="{{results.length > 0}}">
      <song-row
        has:for="{{results}}"
        song="{{item}}"
        index="{{index}}"
        showIndex="{{true}}"
        bind:tap="onResultTap"
        bind:menu="onResultMenu"
      ></song-row>
    </view>
    <empty has:else text="没有找到相关歌曲"></empty>
  </view>

  <mini-player id="miniPlayer" bind:open="onOpenPlayer" bind:toggle="onTogglePlayer"></mini-player>
</view>
