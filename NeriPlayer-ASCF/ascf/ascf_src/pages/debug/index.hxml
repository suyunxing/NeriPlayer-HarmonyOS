<view class="page">
  <view class="group">
    <view class="group-title"><text>应用</text></view>
    <view class="row">
      <text class="label">版本</text>
      <text class="value">{{appVersion}}</text>
    </view>
    <view class="row">
      <text class="label">网络类型</text>
      <text class="value">{{networkType}}</text>
    </view>
  </view>

  <view class="group">
    <view class="group-title"><text>能力检查</text></view>
    <view class="row" has:for="{{apiChecks}}" has:key="name">
      <text class="label">{{item.name}}</text>
      <text class="value {{item.ok ? 'ok' : 'bad'}}">{{item.ok ? '可用' : '不可用'}}</text>
    </view>
  </view>

  <view class="group" has:if="{{systemInfo}}">
    <view class="group-title"><text>系统信息</text></view>
    <view class="row">
      <text class="label">品牌/型号</text>
      <text class="value">{{systemInfo.brand}} {{systemInfo.model}}</text>
    </view>
    <view class="row">
      <text class="label">系统</text>
      <text class="value">{{systemInfo.system}} {{systemInfo.OSApiVersion}}</text>
    </view>
    <view class="row">
      <text class="label">屏幕</text>
      <text class="value">{{systemInfo.screenWidth}}x{{systemInfo.screenHeight}}</text>
    </view>
  </view>

  <view class="group">
    <view class="group-title"><text>存储</text></view>
    <view class="row" has:if="{{storageInfo}}">
      <text class="label">已用/限制</text>
      <text class="value">{{storageInfo.currentSize}}KB / {{storageInfo.limitSize}}KB</text>
    </view>
    <view class="row">
      <text class="label">清空数据</text>
      <text class="value link" bindtap="onClearStorage">清空</text>
    </view>
  </view>

  <view class="group">
    <view class="group-title"><text>网络接口自检</text></view>
    <view class="row">
      <text class="label">网易云搜索</text>
      <text class="value link" bindtap="onTestNetease">{{testing ? '测试中...' : '测试'}}</text>
    </view>
    <view class="test-result" has:if="{{testResult}}">
      <text class="test-text">{{testResult}}</text>
    </view>
  </view>
</view>
