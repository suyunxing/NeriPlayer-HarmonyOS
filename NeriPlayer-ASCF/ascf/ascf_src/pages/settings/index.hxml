<view class="page">
  <view class="group">
    <view class="group-title"><text>默认平台</text></view>
    <view class="group-body">
      <view
        class="option {{settings.selectedPlatform === 1 ? 'selected' : ''}}"
        data-value="1"
        bindtap="onPlatformChange"
      >
        <text>网易云音乐</text>
      </view>
      <view
        class="option {{settings.selectedPlatform === 2 ? 'selected' : ''}}"
        data-value="2"
        bindtap="onPlatformChange"
      >
        <text>哔哩哔哩</text>
      </view>
      <view
        class="option {{settings.selectedPlatform === 3 ? 'selected' : ''}}"
        data-value="3"
        bindtap="onPlatformChange"
      >
        <text>YouTube Music</text>
      </view>
    </view>
  </view>

  <view class="group">
    <view class="group-title"><text>播放</text></view>
    <view class="group-body">
      <view class="setting-row">
        <text class="setting-label">音质（网易云）</text>
        <view class="seg">
          <view
            class="seg-item {{settings.quality === 'standard' ? 'active' : ''}}"
            data-value="standard"
            bindtap="onQualityChange"
          >
            <text>标准</text>
          </view>
          <view
            class="seg-item {{settings.quality === 'high' ? 'active' : ''}}"
            data-value="high"
            bindtap="onQualityChange"
          >
            <text>高</text>
          </view>
          <view
            class="seg-item {{settings.quality === 'exhigh' ? 'active' : ''}}"
            data-value="exhigh"
            bindtap="onQualityChange"
          >
            <text>极高</text>
          </view>
        </view>
      </view>

      <view class="setting-row">
        <text class="setting-label">播放速度（实验性）</text>
        <view class="seg">
          <view
            class="seg-item {{speedIndex === 0 ? 'active' : ''}}"
            data-value="1.0"
            bindtap="onSpeedChange"
          >
            <text>1.0x</text>
          </view>
          <view
            class="seg-item {{speedIndex === 1 ? 'active' : ''}}"
            data-value="1.25"
            bindtap="onSpeedChange"
          >
            <text>1.25x</text>
          </view>
          <view
            class="seg-item {{speedIndex === 2 ? 'active' : ''}}"
            data-value="1.5"
            bindtap="onSpeedChange"
          >
            <text>1.5x</text>
          </view>
        </view>
      </view>

      <view class="setting-row">
        <text class="setting-label">自动播放下一首</text>
        <switch
          checked="{{settings.autoNext !== false}}"
          data-field="autoNext"
          bindchange="onSwitchChange"
          color="#4a90d9"
        />
      </view>
    </view>
  </view>

  <view class="group">
    <view class="group-title"><text>数据</text></view>
    <view class="group-body">
      <view class="setting-row">
        <text class="setting-label">记录播放历史</text>
        <switch
          checked="{{settings.enableHistory !== false}}"
          data-field="enableHistory"
          bindchange="onSwitchChange"
          color="#4a90d9"
        />
      </view>
      <view class="setting-row">
        <text class="setting-label">记录播放统计</text>
        <switch
          checked="{{settings.enableStats !== false}}"
          data-field="enableStats"
          bindchange="onSwitchChange"
          color="#4a90d9"
        />
      </view>
    </view>
  </view>

  <view class="group">
    <view class="group-title"><text>关于</text></view>
    <view class="group-body">
      <view class="setting-row" bindtap="onDebugTap">
        <text class="setting-label">调试信息</text>
        <text class="arrow">›</text>
      </view>
      <view class="setting-row" bindtap="onDisclaimerTap">
        <text class="setting-label">免责声明</text>
        <text class="arrow">›</text>
      </view>
      <view class="setting-row">
        <text class="setting-label">版本</text>
        <text class="value-text">{{appVersion}}</text>
      </view>
    </view>
  </view>

  <mini-player id="miniPlayer" bind:open="onOpenPlayer" bind:toggle="onTogglePlayer"></mini-player>
</view>
