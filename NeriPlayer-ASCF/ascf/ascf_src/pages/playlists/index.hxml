<view class="page">
  <view class="create-btn" bindtap="onCreateTap">
    <text class="create-text">＋ 新建歌单</text>
  </view>

  <view class="pending" has:if="{{pendingSong}}">
    <text class="pending-text">将「{{pendingSong.customName || pendingSong.name}}」添加到：</text>
    <text class="pending-cancel" bindtap="onPendingCancel">取消</text>
  </view>

  <view has:if="{{playlists.length > 0}}">
    <view
      class="playlist-row"
      has:for="{{playlists}}"
      data-id="{{item.id}}"
      bindtap="onPlaylistTap"
    >
      <view class="cover placeholder"></view>
      <view class="playlist-info">
        <text class="playlist-name" max-lines="1">{{item.name}}</text>
        <text class="playlist-count">{{item.songs.length || item.songKeys.length}} 首</text>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>
  <empty has:else text="还没有歌单，点击上方按钮创建"></empty>
</view>
