<view class="page">
  <view class="mode-tabs">
    <view class="mode-tab {{mode === 'song' ? 'active' : ''}}" data-mode="song" bindtap="onModeChange">
      <text>歌曲</text>
    </view>
    <view class="mode-tab {{mode === 'playlist' ? 'active' : ''}}" data-mode="playlist" bindtap="onModeChange">
      <text>歌单（网易云）</text>
    </view>
  </view>

  <view class="search-box">
    <input
      class="search-input"
      placeholder="搜索关键词"
      placeholder-class="placeholder"
      value="{{keyword}}"
      bindinput="onKeywordInput"
      confirm-type="search"
      bindconfirm="onSearchTap"
    />
    <view class="search-btn" bindtap="onSearchTap">
      <text class="search-btn-text">搜索</text>
    </view>
  </view>

  <view has:if="{{searched}}">
    <view has:if="{{searching}}"><text class="hint">搜索中...</text></view>
    <view has:elif="{{errorMessage}}"><text class="hint error">{{errorMessage}}</text></view>
    <view has:elif="{{mode === 'song'}}">
      <view has:if="{{songs.length > 0}}">
        <song-row
          has:for="{{songs}}"
          song="{{item}}"
          index="{{index}}"
          showIndex="{{true}}"
          bind:tap="onSongTap"
        ></song-row>
      </view>
      <empty has:else text="没有找到相关歌曲"></empty>
    </view>
    <view has:else>
      <view has:if="{{playlists.length > 0}}">
        <view
          class="playlist-row"
          has:for="{{playlists}}"
          data-id="{{item.id}}"
          bindtap="onPlaylistTap"
        >
          <image class="playlist-cover" src="{{item.coverImgUrl}}" mode="aspectFill"></image>
          <view class="playlist-info">
            <text class="playlist-name" max-lines="1">{{item.name}}</text>
            <text class="playlist-count">{{item.trackCount || 0}} 首</text>
          </view>
          <text class="arrow">›</text>
        </view>
      </view>
      <empty has:else text="没有找到相关歌单"></empty>
    </view>
  </view>
</view>
