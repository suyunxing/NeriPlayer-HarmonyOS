<view class="page">
  <view class="header">
    <text class="greeting">{{greeting}}</text>
    <text class="app-name">NeriPlayer</text>
  </view>

  <view class="search-bar" bindtap="onSearchTap">
    <text class="search-text">搜索歌曲 / 歌手 / 歌单</text>
  </view>

  <view class="section">
    <view class="section-head">
      <text class="section-title">最近播放</text>
    </view>
    <view has:if="{{history.length > 0}}">
      <song-row
        has:for="{{history}}"
        song="{{item}}"
        index="{{index}}"
        bind:tap="onHistoryTap"
      ></song-row>
    </view>
    <empty has:else text="还没有播放记录，去探索里找首歌吧"></empty>
  </view>

  <mini-player id="miniPlayer" bind:open="onOpenPlayer" bind:toggle="onTogglePlayer"></mini-player>
</view>
