<view class="page">
  <view class="header" has:if="{{playlist}}">
    <view class="header-info">
      <text class="name">{{playlist.name}}</text>
      <text class="desc" has:if="{{playlist.description}}">{{playlist.description}}</text>
      <text class="count">{{songs.length}} 首</text>
    </view>
    <view class="actions">
      <view class="action-btn" bindtap="onPlayAll">
        <text class="action-text">播放全部</text>
      </view>
      <view class="action-btn danger" bindtap="onDeletePlaylist">
        <text class="action-text">删除歌单</text>
      </view>
    </view>
  </view>

  <view has:if="{{songs.length > 0}}">
    <song-row
      has:for="{{songs}}"
      song="{{item}}"
      index="{{index}}"
      showIndex="{{true}}"
      bind:tap="onSongTap"
      bind:menu="onSongMenu"
    ></song-row>
  </view>
  <empty has:else text="歌单是空的"></empty>
</view>
