<view class="page">
  <scroll-view class="lyric-area" scroll-y="true" scroll-into-view="line-{{currentLine}}">
    <view class="lyric-pad"></view>
    <view has:if="{{lyrics.length > 0}}">
      <view
        id="line-{{index}}"
        class="lyric-line {{currentLine === index ? 'active' : ''}}"
        has:for="{{lyrics}}"
        has:key="timeMs"
        bindtap="onLyricTap"
      >
        <text>{{item.text}}</text>
        <text class="translated" has:if="{{item.translated}}">{{item.translated}}</text>
      </view>
    </view>
    <view class="lyric-empty" has:else>
      <image class="big-cover" src="{{coverUrl}}" mode="aspectFill" has:if="{{coverUrl}}"></image>
      <view class="big-cover placeholder" has:else></view>
      <text class="lyric-empty-text">{{lyricSource === 'none' ? '暂无歌词' : '正在加载歌词...'}}</text>
    </view>
    <view class="lyric-pad"></view>
  </scroll-view>

  <view class="controls">
    <view class="meta">
      <text class="song-title" max-lines="1">{{title}}</text>
      <text class="song-artist" max-lines="1">{{artist}}</text>
    </view>

    <view class="progress-row">
      <text class="time">{{positionText}}</text>
      <slider
        class="progress"
        min="0"
        max="{{durationMs}}"
        value="{{sliderValue}}"
        step="1000"
        block-size="16"
        active-color="#4a90d9"
        backgroundColor="#3a3a3a"
        block-color="#ffffff"
        bindchanging="onSliderChanging"
        bindchange="onSliderChange"
      />
      <text class="time">{{durationText}}</text>
    </view>

    <view class="mode-row">
      <view class="mode-btn" bindtap="onShuffleTap">
        <text class="mode-icon {{shuffle ? 'active' : ''}}">⤨</text>
      </view>
      <view class="mode-btn" bindtap="onRepeatTap">
        <text class="mode-icon {{repeatMode !== 0 ? 'active' : ''}}">
          {{repeatMode === 1 ? '🔂 单曲' : repeatMode === 2 ? '🔁 列表' : '↻ 顺序'}}
        </text>
      </view>
      <view class="mode-btn">
        <text class="status-text">{{statusText}}</text>
      </view>
    </view>

    <view class="main-controls">
      <view class="ctrl-btn" bindtap="onPrev">
        <text class="ctrl-icon">⏮</text>
      </view>
      <view class="play-btn" bindtap="onTogglePlay">
        <text class="play-icon">{{loading ? '…' : (playing ? '❚❚' : '▶')}}</text>
      </view>
      <view class="ctrl-btn" bindtap="onNext">
        <text class="ctrl-icon">⏭</text>
      </view>
    </view>

    <view class="error" has:if="{{errorMessage}}">
      <text class="error-text">{{errorMessage}}</text>
    </view>
  </view>
</view>
