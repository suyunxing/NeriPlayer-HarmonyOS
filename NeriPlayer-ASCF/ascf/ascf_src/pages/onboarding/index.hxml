<view class="page">
  <view class="logo">
    <text class="logo-text">NeriPlayer</text>
    <text class="logo-sub">鸿蒙元服务 · ASCF</text>
  </view>

  <view class="section">
    <text class="section-title">选择默认音乐平台</text>
    <view class="platform {{platform === 1 ? 'selected' : ''}}" data-platform="1" bindtap="onPlatformTap">
      <text class="platform-name">网易云音乐</text>
      <text class="platform-desc">搜索 / 歌单 / 歌词</text>
    </view>
    <view class="platform {{platform === 2 ? 'selected' : ''}}" data-platform="2" bindtap="onPlatformTap">
      <text class="platform-name">哔哩哔哩</text>
      <text class="platform-desc">视频音频流搜索播放</text>
    </view>
    <view class="platform {{platform === 3 ? 'selected' : ''}}" data-platform="3" bindtap="onPlatformTap">
      <text class="platform-name">YouTube Music</text>
      <text class="platform-desc">搜索（流解析待移植）</text>
    </view>
  </view>

  <view class="start-btn" bindtap="onStart">
    <text class="start-text">开始使用</text>
  </view>
</view>
