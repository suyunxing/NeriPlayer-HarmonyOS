const FIXTURES: QrFixture[] = buildFixtures();

function fixture(payloadPrefix: string): QrFixture {
  for (const f of FIXTURES) {
    if (f.payload.startsWith(payloadPrefix)) {
      return f;
    }
  }
  throw new Error('fixture not found: ' + payloadPrefix);
}

export default function qrEncoderTest(): void {
  describe('QrEncoder', () => {
    it('fixturesMatchReferenceByteForByte', 0, () => {
      expect(FIXTURES.length).assertEqual(4);
      for (const f of FIXTURES) {
        const r = encodeQr(f.payload, f.mask);
        expect(r.version).assertEqual(f.version);
        expect(r.matrix.size).assertEqual(f.size);
        for (let i = 0; i < f.size; i++) {
          expect(r.matrix.rowString(i)).assertEqual(f.rows[i]);
        }
      }
    });

    it('utf8EncodeHandlesAsciiAndCjk', 0, () => {
      const ascii = utf8Encode('abc');
      expect(ascii.length).assertEqual(3);
      expect(ascii[0]).assertEqual(97);
      const cjk = utf8Encode('\u4e91\u97f3');
      expect(cjk.length).assertEqual(6);
      expect(cjk[0]).assertEqual(0xe4);
      const emoji = utf8Encode('\ud83d\ude00');
      expect(emoji.length).assertEqual(4);
      expect(emoji[0]).assertEqual(0xf0);
    });

    it('selectVersionPicksCapacityBoundaries', 0, () => {
      expect(selectVersion(11, 10)).assertEqual(1);
      expect(selectVersion(180, 10)).assertEqual(9);
      expect(selectVersion(181, 10)).assertEqual(10);
      expect(selectVersion(213, 10)).assertEqual(10);
      expect(selectVersion(214, 10)).assertEqual(-1);
    });

    it('autoMaskProducesValidSymbolShape', 0, () => {
      const f = fixture('a1b2c3d4');
      const r = encodeQr(f.payload);
      expect(r.version).assertEqual(f.version);
      expect(r.mask >= 0 && r.mask <= 7).assertTrue();
      expect(r.matrix.isDark(0, 0)).assertTrue();
      expect(r.matrix.isDark(3, 3)).assertTrue();
      expect(r.matrix.isDark(0, f.size - 1)).assertTrue();
      expect(r.matrix.isDark(f.size - 1, 0)).assertTrue();
      expect(r.matrix.isDark(f.size - 8, 8)).assertTrue();
    });

    it('oversizedPayloadThrows', 0, () => {
      let threw = false;
      try {
        encodeQr('x'.repeat(214));
      } catch (e) {
        threw = true;
      }
      expect(threw).assertTrue();
    });
  });
}
