/**
 * Byte-level fixtures generated by an INDEPENDENT encoder
 * (D:/HarmonyOS/tmp-m52b/gen-fixture.mjs — hand-rolled protobuf wire rules
 * with kotlinx encodeDefaults=false semantics; gzip variants from Node zlib
 * and a real java.util.zip.GZIPOutputStream run via the Studio jbr), so the
 * ArkTS decoder is validated against bytes it did not produce itself.
 * Semantics follow Android SyncDataSerializerBinaryStreamTest (gzip magic,
 * legacy base64 read-both, corrupt/empty failure) plus protobuf fields.
 */
const CURRENT_PROTO_HEX: string =
  '';
// legacy schema: song tag 8 is a varint addedAt (pre-mediaUri layout)
const LEGACY_PROTO_HEX: string =
  '';
const UNKNOWN_FIELD_PROTO_HEX: string = '0a07322e302d756e6b2a1808011202706c1a1008051201739a06050a01781001980607';
// current-proto bytes as written by java.util.zip.GZIPOutputStream (jbr 21)
const JAVA_GZIP_B64: string =
  '';
// Node zlib gzip of the same proto bytes: dynamic / stored deflate variants
const GZIP_DYNAMIC_B64: string =
  '';
const GZIP_STORED_B64: string =
  '';
const GZIP_FIXED_B64: string =
  '';
const LEGACY_GZIP_B64: string =
  'H4sIAAAAAAAACuPiMtSz1M1JTU9MrhTigtC6KallUhz+OSkBGfl5qQoHFr/u6zHWmsLIwS7E+Wz68mdre572TpUq5dj6bfKHjjv///9nFOL2AetUCM7PS5fihXIci0oyi0uUeGDcnKTSXA1GgxfsVnwZJSUFVvr6yfqGelkF6Q4Nc2Z/7DT2Eog2MLAyMNAzMIiFuCQISeT5/t0v1k9UaLh1+GCnsQZEhwGj1VRGZHcMjKMkXiwGKVVCCj8ncY4Lq0GCyIEqwazADgAKXiBIcQEAAA==';
const BAD_CRC_B64: string =
