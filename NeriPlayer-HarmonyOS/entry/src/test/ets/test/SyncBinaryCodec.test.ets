const BASE64_TEXT_WITH_NEWLINES: string =
  'H4sIAAAAAAAACuPiMNIz0C1JLS4R4s7I1U1JLctMTtU1lGIJKC1KVPj9oe9Zt7HW\nYUYOLSHBZ1u7X6yf+mxtz9PeqQof5vdtlZrNyNF+/m3zpis71jMKsT2bueXpkpVS\nnE8nrng2d8OTPcuUOJ/2b3vWvOD5vj6NTjaDE1sFrBQySkoKiq309QsM9XJLizOT\n9QyNzPTyUkv0K/Qr9bIK0p0E8lJLUhOLU6309Yvz89L1DT0anl24321c0PEfChh3\nMbJDFR1iZDY0Mr7FyMnFmpJappsowHqLkYWLQYDzASOjQsOSn+u7jTUg2i0YjUw4\nOIXYnk3Z9mJ6vwKzFswIi4ZHCxu6jR1+g6kkloIcXcMszqed658taH+5aIbVAWQ/\nDmoPSzRM3vyk21gJOR41TtxnclLgeDELJIMSwxJsClpGbAU5iZWpKV7WSN5C+EEK\nw2kKFxaBDNJCNihoCiMXj6GRcQ1UcQ2BgFnQy2bAbgFxqwMkjgJObBWIwrAsAe6m\njE62ggVzGCuYmhg1uJDtFmg43Duj21ii4SOLAqsGxDADiNERDa1Pj3cbJzUzcjRM\neH6521gIxZFSUEcqIRyphXCkwYJeNgt2B4hJHhBzI05sFciAO6mgk62LeMdkmXFo\nCcD1SiGFxo5VIHkjZHOsEJELANmmfoaeAwAA';

const BIG_ID_TEXT: string = '98765432101234567';
const BIG_ID_APPROX: number = 98765432101234560;
const MAX_DECOMPRESSED: number = 16 * 1024 * 1024;

function hexToBytes(hex: string): Uint8Array {
  const out = new Uint8Array(hex.length / 2);
  for (let i = 0; i < out.length; i++) {
    out[i] = parseInt(hex.substring(i * 2, i * 2 + 2), 16);
  }
  return out;
}

function b64ToBytes(text: string): Uint8Array {
  const decoded = decodeLegacyBase64Text(text);
  expect(decoded !== null).assertTrue();
  return decoded as Uint8Array;
}

function bytesEqual(a: Uint8Array, b: Uint8Array): boolean {
  if (a.length !== b.length) {
    return false;
  }
  for (let i = 0; i < a.length; i++) {
    if (a[i] !== b[i]) {
      return false;
    }
  }
  return true;
}

function currentProtoBytes(): Uint8Array {
  return hexToBytes(CURRENT_PROTO_HEX);
}

export default function syncBinaryCodecTest(): void {
  describe('SyncBinaryCodec', () => {
    it('decodesCurrentSchemaProtoBytes', 0, () => {
      const decoded = decodeSyncDataProto(currentProtoBytes(), 1755999999999);
      expect(decoded !== null).assertTrue();
      const data = decoded as SyncData;
      expect(data.version).assertEqual('2.0-test');
      expect(data.deviceId).assertEqual('hm-device-1');
      expect(data.deviceName).assertEqual('Pura');
      expect(data.lastModified).assertEqual(1755513600123);
      expect(data.playbackStatsClearedAt).assertEqual(1755450000000);

      expect(data.playlists.length).assertEqual(1);
      const playlist = data.playlists[0];
      expect(playlist.id).assertEqual(42);
      expect(playlist.name).assertEqual('测试歌单 🎵');
      expect(playlist.createdAt).assertEqual(1755400000000);
      expect(playlist.modifiedAt).assertEqual(1755500000000);
      expect(playlist.isDeleted).assertFalse();
      expect(playlist.songOrderVersion).assertEqual(1);

      expect(playlist.songs.length).assertEqual(1);
      const song = playlist.songs[0];
      expect(song.id).assertEqual(BIG_ID_APPROX);
      expect(song.syncIdText).assertEqual(BIG_ID_TEXT);
      expect(songIdKeyText(song)).assertEqual(BIG_ID_TEXT);
      expect(song.name).assertEqual('晴天');
      expect(song.artist).assertEqual('周杰伦');
      expect(song.album).assertEqual('叶惠美');
      expect(song.albumId).assertEqual(777);
      expect(song.durationMs).assertEqual(269000);
      expect(song.coverUrl).assertEqual('https://p1.music.126.net/x/y.jpg');
      expect(song.mediaUri).assertEqual('netease://song/1');
      expect(song.addedAt).assertEqual(1755500000000);
      expect(song.userLyricOffsetMs).assertEqual(-120);
      expect(song.channelId).assertEqual('netease');
      expect(song.audioId).assertEqual('123');
      expect(song.subAudioId).assertNull();
      expect(song.syncMetadataVersion).assertEqual(1);
      expect(song.legacyAddedAt).assertNull();

      expect(data.favoritePlaylists.length).assertEqual(1);
      const favorite = data.favoritePlaylists[0];
      expect(favorite.id).assertEqual(9);
      expect(favorite.name).assertEqual('收藏');
      expect(favorite.coverUrl).assertNull();
      expect(favorite.trackCount).assertEqual(3);
      expect(favorite.source).assertEqual('netease');
      expect(favorite.songs.length).assertEqual(0);
      expect(favorite.addedTime).assertEqual(1755300000000);
      expect(favorite.modifiedAt).assertEqual(1755300000123);
      expect(favorite.sortOrder).assertEqual(1755300000000);
      expect(favorite.playlistId).assertEqual('pl-1');
      expect(favorite.subtitle).assertEqual('副标题');

      expect(data.recentPlays.length).assertEqual(1);
      const recent = data.recentPlays[0];
      expect(recent.songId).assertEqual(BIG_ID_APPROX);
      expect(syncSongEquals(recent.song, song)).assertTrue();
      expect(recent.playedAt).assertEqual(1755510000000);
      expect(recent.resumePositionMs).assertEqual(45000);

      expect(data.syncLog.length).assertEqual(1);
      const log = data.syncLog[0];
      expect(log.timestamp).assertEqual(1755510001000);
      expect(log.action).assertEqual(SyncAction.PLAY_SONG);
      expect(log.playlistId).assertEqual(42);
      expect(log.songId).assertNull();
      expect(log.details).assertEqual('played');

      expect(data.recentPlayDeletions.length).assertEqual(1);
      const recentDeletion = data.recentPlayDeletions[0];
      expect(recentDeletion.syncSongIdText).assertEqual(BIG_ID_TEXT);
      expect(recentDeletion.album).assertEqual('叶惠美');
      expect(recentDeletion.mediaUri).assertEqual('netease://song/1');
      expect(recentDeletion.deletedAt).assertEqual(1755510002000);

      expect(data.playbackStats.length).assertEqual(1);
      const stat = data.playbackStats[0];
      expect(stat.identityKey).assertEqual('123|netease|');
      expect(stat.playCount).assertEqual(7);
      expect(stat.totalListenMs).assertEqual(100000);
      expect(stat.coverUrl).assertNull();
      expect(stat.mediaUri).assertEqual('netease://song/1');
      expect(stat.counterBaseListenMs).assertEqual(20000);
      expect(stat.counterBasePlayCount).assertEqual(2);
      expect(stat.counterShards.length).assertEqual(1);
      const shard = stat.counterShards[0];
      expect(shard.deviceId).assertEqual('hm-device-1');
      expect(shard.epochStartedAt).assertEqual(1755350000000);
      expect(shard.totalListenMs).assertEqual(80000);
      expect(shard.playCount).assertEqual(5);
      expect(shard.firstPlayedAt).assertEqual(1755400000000);
      expect(shard.lastPlayedAt).assertEqual(1755510000000);

      expect(data.playbackStatBuckets.length).assertEqual(1);
      const bucket = data.playbackStatBuckets[0];
      expect(bucket.dayStartAt).assertEqual(1755475200000);
      expect(bucket.identityKey).assertEqual('123|netease|');
      expect(bucket.counterShards.length).assertEqual(1);

      expect(data.playlistSongDeletions.length).assertEqual(1);
      const deletion = data.playlistSongDeletions[0];
      expect(deletion.playlistId).assertEqual(42);
      expect(deletion.syncSongIdText).assertEqual(BIG_ID_TEXT);
      expect(deletion.mediaUri).assertNull();
      expect(deletion.deletedAt).assertEqual(1755510003000);
      expect(deletion.removedMembershipTokens.length).assertEqual(1);
      expect(deletion.removedMembershipTokens[0].deviceId).assertEqual('dev-a');
      expect(deletion.removedMembershipTokens[0].counter).assertEqual(5);
    });

    it('normalizesMembershipTokensFromProto', 0, () => {
      const decoded = decodeSyncDataProto(currentProtoBytes());
      expect(decoded !== null).assertTrue();
      const song = (decoded as SyncData).playlists[0].songs[0];
      // The fixture carries one valid and one invalid (empty deviceId) token.
      expect(song.syncMembershipTokens.length).assertEqual(1);
      expect(song.syncMembershipTokens[0].deviceId).assertEqual('dev-a');
      expect(song.syncMembershipTokens[0].counter).assertEqual(5);
    });

    it('skipsUnknownFieldNumbers', 0, () => {
      const decoded = decodeSyncDataProto(hexToBytes(UNKNOWN_FIELD_PROTO_HEX));
      expect(decoded !== null).assertTrue();
      const data = decoded as SyncData;
      expect(data.version).assertEqual('2.0-unk');
      const song = data.playlists[0].songs[0];
      expect(song.id).assertEqual(5);
      expect(song.name).assertEqual('s');
    });

    it('appliesKotlinxDefaultsForMissingFields', 0, () => {
      // Empty message: every collection defaults to [], lastModified to nowMs
      // (Android default is System.currentTimeMillis()).
      const decoded = decodeSyncDataProto(new Uint8Array(0), 1755999999999);
      expect(decoded !== null).assertTrue();
      const data = decoded as SyncData;
      expect(data.version).assertEqual('2.0');
      expect(data.lastModified).assertEqual(1755999999999);
      expect(data.playlists.length).assertEqual(0);
      expect(data.playlistSongDeletions.length).assertEqual(0);
      // Only tag 4 (lastModified=255) present.
      const minimal = decodeSyncDataProto(hexToBytes('20ff01'), 1);
      expect(minimal !== null).assertTrue();
      expect((minimal as SyncData).lastModified).assertEqual(255);
    });

    it('fallsBackToLegacySchemaForPreMediaUriBytes', 0, () => {
      const legacyBytes = hexToBytes(LEGACY_PROTO_HEX);
      // Current schema must fail on the tag-8 wire-type collision (varint
      // addedAt vs string mediaUri) — this is the Android fallback trigger.
      expect(decodeSyncDataProto(legacyBytes)).assertNull();
      // Legacy schema decodes, then maps like LegacySyncData.toCurrent().
      const decoded = decodeLegacySyncData(legacyBytes, 1755999999999);
      expect(decoded !== null).assertTrue();
      const data = decoded as SyncData;
      expect(data.version).assertEqual('1.9-legacy');
      expect(data.deviceId).assertEqual('legacy-dev');
      expect(data.lastModified).assertEqual(1755599000000);
      expect(data.playlists.length).assertEqual(1);
      const playlist = data.playlists[0];
      expect(playlist.id).assertEqual(7);
      expect(playlist.name).assertEqual('旧歌单');
      expect(playlist.isDeleted).assertTrue();
      expect(playlist.songOrderVersion).assertEqual(0);
      const song = playlist.songs[0];
      expect(song.id).assertEqual(-1234567890123); // exact negative 64-bit varint
      expect(song.syncIdText).assertEqual('');
      expect(song.coverUrl).assertEqual('http://c/1.jpg');
      expect(song.addedAt).assertEqual(1755000000000);
      expect(song.mediaUri).assertNull();
      expect(song.matchedLyric).assertEqual('[00:00.00]legacy');
      expect(song.matchedTranslatedLyric).assertEqual('[00:00.00]翻译');
      expect(song.channelId).assertNull();
      expect(song.syncMembershipTokens.length).assertEqual(0);
      expect(song.syncMetadataVersion).assertEqual(0);
      expect(song.legacyAddedAt).assertNull();
      expect(data.recentPlays.length).assertEqual(1);
      expect(data.recentPlays[0].resumePositionMs).assertEqual(0);
      expect(data.recentPlays[0].songId).assertEqual(-1234567890123);
      expect(data.syncLog.length).assertEqual(1);
      expect(data.syncLog[0].action).assertEqual(SyncAction.ADD_SONG);
      expect(data.syncLog[0].playlistId).assertEqual(7);
      expect(data.recentPlayDeletions.length).assertEqual(0);
      expect(data.playbackStats.length).assertEqual(0);
      // The combined entry point applies the same fallback order.
      expect(decodeProtoSyncDataWithLegacyFallback(legacyBytes) !== null).assertTrue();
    });

    it('inflatesStoredFixedAndDynamicDeflateBlocks', 0, () => {
      const proto = currentProtoBytes();
      const dynamic = gunzip(b64ToBytes(GZIP_DYNAMIC_B64), MAX_DECOMPRESSED);
      expect(dynamic !== null).assertTrue();
      expect(bytesEqual(dynamic as Uint8Array, proto)).assertTrue();
      const stored = gunzip(b64ToBytes(GZIP_STORED_B64), MAX_DECOMPRESSED);
      expect(stored !== null).assertTrue();
      expect(bytesEqual(stored as Uint8Array, proto)).assertTrue();
      const fixed = gunzip(b64ToBytes(GZIP_FIXED_B64), MAX_DECOMPRESSED);
      expect(fixed !== null).assertTrue();
      expect(bytesEqual(fixed as Uint8Array, proto)).assertTrue();
    });

    it('inflatesMultiMemberAndRealJavaGzipStreams', 0, () => {
      // Two concatenated members decode to the concatenated payloads. The
      // gzip bytes are concatenated first, then inflated in one call —
      // concatenating the two base64 strings themselves would put '==' pads
      // in the middle, which java.util.Base64 rejects too.
      const member0 = b64ToBytes(GZIP_DYNAMIC_B64);
      const member1 = b64ToBytes(GZIP_STORED_B64);
      const multiBytes = new Uint8Array(member0.length + member1.length);
      multiBytes.set(member0, 0);
      multiBytes.set(member1, member0.length);
      const multi = gunzip(multiBytes, MAX_DECOMPRESSED);
      expect(multi !== null).assertTrue();
      const proto = currentProtoBytes();
      const doubled = new Uint8Array(proto.length * 2);
      doubled.set(proto, 0);
      doubled.set(proto, proto.length);
      expect(bytesEqual(multi as Uint8Array, doubled)).assertTrue();
      // Bytes written by a real java.util.zip.GZIPOutputStream (non-zero
      // MTIME / different OS header bytes than the Node variants above).
      const javaGzip = gunzip(b64ToBytes(JAVA_GZIP_B64), MAX_DECOMPRESSED);
      expect(javaGzip !== null).assertTrue();
      expect(bytesEqual(javaGzip as Uint8Array, proto)).assertTrue();
    });

    it('rejectsCorruptedGzipStreams', 0, () => {
      // Truncated header, mirroring the Android corrupt-remote test bytes.
      expect(gunzip(hexToBytes('1f8b080001'), MAX_DECOMPRESSED)).assertNull();
      expect(gunzip(new Uint8Array(0), MAX_DECOMPRESSED)).assertNull();
      // Wrong CM byte after the magic.
      const wrongCm = b64ToBytes(GZIP_DYNAMIC_B64).slice();
      wrongCm[2] = 0x09;
      expect(gunzip(wrongCm, MAX_DECOMPRESSED)).assertNull();
      // Corrupted CRC32 trailer must fail verification.
      expect(gunzip(b64ToBytes(BAD_CRC_B64), MAX_DECOMPRESSED)).assertNull();
      // Decompression ceiling is enforced (proto is 926 bytes).
      const capped = gunzip(b64ToBytes(GZIP_DYNAMIC_B64), 900);
      expect(capped).assertNull();
    });

    it('decodesGzipProtoChannelThroughReadBoth', 0, () => {
      const result = deserializeSyncContent(b64ToBytes(GZIP_DYNAMIC_B64));
      expect(result.format).assertEqual(SyncWireFormat.GZIP_PROTO);
      expect(result.data !== null).assertTrue();
      const data = result.data as SyncData;
      expect(data.version).assertEqual('2.0-test');
      expect(data.playlists[0].songs[0].syncIdText).assertEqual(BIG_ID_TEXT);
      // Java-written gzip bytes through the same channel.
      const javaResult = deserializeSyncContent(b64ToBytes(JAVA_GZIP_B64));
      expect(javaResult.format).assertEqual(SyncWireFormat.GZIP_PROTO);
      expect((javaResult.data as SyncData).version).assertEqual('2.0-test');
      // Truncated stream is reported as malformed, not thrown.
      const truncated = deserializeSyncContent(hexToBytes('1f8b080001'));
      expect(truncated.format).assertEqual(SyncWireFormat.GZIP_PROTO);
      expect(truncated.data).assertNull();
      expect(truncated.errorMessage.length > 0).assertTrue();
    });

    it('decodesLegacyBase64ChannelThroughReadBoth', 0, () => {
      const result = deserializeSyncContent(utf8EncodeText(BASE64_TEXT_WITH_NEWLINES));
      expect(result.format).assertEqual(SyncWireFormat.LEGACY_BASE64);
      expect(result.data !== null).assertTrue();
      const data = result.data as SyncData;
      expect(data.version).assertEqual('2.0-test');
      expect(data.deviceId).assertEqual('hm-device-1');
      // Legacy-schema bytes over the legacy base64 channel: gzip → legacy
      // proto fallback, the full old backup.bin path.
      const legacyResult = deserializeSyncContent(utf8EncodeText(LEGACY_GZIP_B64));
      expect(legacyResult.format).assertEqual(SyncWireFormat.LEGACY_BASE64);
      expect(legacyResult.data !== null).assertTrue();
      const legacyData = legacyResult.data as SyncData;
      expect(legacyData.version).assertEqual('1.9-legacy');
      expect(legacyData.playlists[0].songs[0].addedAt).assertEqual(1755000000000);
      // Android's "H4sI!invalid" case: illegal characters fail before inflate.
      const invalid = deserializeSyncContent(utf8EncodeText('H4sI!invalid'));
      expect(invalid.format).assertEqual(SyncWireFormat.LEGACY_BASE64);
      expect(invalid.data).assertNull();
      expect(invalid.errorMessage.length > 0).assertTrue();
    });

    it('decodesLegacyBase64Variants', 0, () => {
      expect(decodeLegacyBase64Text('')).assertNull();
      expect(decodeLegacyBase64Text('A')).assertNull();
      expect(decodeLegacyBase64Text('ABCDE')).assertNull(); // length % 4
      expect(decodeLegacyBase64Text('AB=C')).assertNull(); // inner padding
      expect(decodeLegacyBase64Text('AB$=')).assertNull(); // illegal char
      const three = decodeLegacyBase64Text('AAAA');
      expect(three !== null).assertTrue();
      expect((three as Uint8Array).length).assertEqual(3);
      expect((three as Uint8Array)[0]).assertEqual(0);
      const one = decodeLegacyBase64Text('AA==');
      expect(one !== null).assertTrue();
      expect((one as Uint8Array).length).assertEqual(1);
      // Whitespace is stripped like Android's filterNot(isWhitespace).
      const spaced = decodeLegacyBase64Text(' AA A A\t');
      expect(spaced !== null).assertTrue();
      expect((spaced as Uint8Array).length).assertEqual(3);
    });
  });
}
